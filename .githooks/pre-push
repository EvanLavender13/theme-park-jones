#!/bin/bash
# pre-push: build windows-debug (warnings as errors), run clang-tidy over the project, and run the
# Windows tests (decision 0030). Checks the working tree, so commit or stash unrelated changes
# first. Linux, with its sanitizers and the cross-build check, is checked at release by
# scripts/release-check.sh.
# Activate once per clone: git config core.hooksPath .githooks

if [ "$(uname -s)" != "Linux" ] || ! command -v cmake.exe >/dev/null; then
    echo "pre-push: the checks run under WSL with cmake.exe on the PATH; push from WSL, or use --no-verify."
    exit 1
fi

# git passes the pushed refs on standard input; no check needs them.
cat >/dev/null

cd "$(git rev-parse --show-toplevel)" || exit 1

if [ ! -f build/windows-debug/CMakeCache.txt ]; then
    echo "pre-push: configuring windows-debug..."
    cmake.exe --preset windows-debug || { echo "pre-push: configure failed."; exit 1; }
fi

# Build output streams to the terminal so progress is visible, and is saved for the warning check.
echo "pre-push: building windows-debug..."
BUILD_LOG=$(mktemp)
trap 'rm -f "$BUILD_LOG"' EXIT
cmake.exe --build --preset windows-debug 2>&1 | tee "$BUILD_LOG"
BUILD_STATUS=${PIPESTATUS[0]}

# Compiler diagnostics only (file:line:column:), not dependency code.
WARNINGS=$(grep -E "^[^ ]+:[0-9]+:[0-9]+: (warning|error):" "$BUILD_LOG" | grep -v "/.cpm-cache/" || true)
if [ "$BUILD_STATUS" -ne 0 ] || [ -n "$WARNINGS" ]; then
    echo "$WARNINGS"
    echo "pre-push: windows-debug build failed or has warnings; push aborted."
    exit 1
fi

# tidy reads linux-debug's compile commands, which need it configured, not built.
if [ ! -f build/linux-debug/compile_commands.json ]; then
    echo "pre-push: configuring linux-debug for clang-tidy..."
    cmake --preset linux-debug >/dev/null || { echo "pre-push: configure failed."; exit 1; }
fi
echo "pre-push: running clang-tidy..."
if ! scripts/tidy.sh; then
    echo "pre-push: clang-tidy found problems; push aborted."
    exit 1
fi

echo "pre-push: running tests..."
if ! ctest.exe --preset windows-debug; then
    echo "pre-push: tests failed; push aborted."
    exit 1
fi

echo "pre-push: all checks passed; pushing."
exit 0
