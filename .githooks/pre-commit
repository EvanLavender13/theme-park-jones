#!/bin/bash
# pre-commit: refuse a new PLAN.md with no Placement section (decision 0027) and a new test case
# with more than two SECTIONs, then clang-format staged C/C++ files (decision 0021).
# clang-tidy runs in scripts/tidy.sh, which the pre-push hook gates.
# Activate once per clone: git config core.hooksPath .githooks
#
# A file with no unstaged changes is formatted in place and re-staged. A file with unstaged
# changes has only its staged version formatted, so work left out of the commit stays out.

# Each PLAN.md the commit adds needs a Placement section (decision 0027). The staged versions are
# checked, since they are what is committed, and -M makes a moved plan a rename, not an addition.
PLANS=()
while IFS= read -r -d '' PLAN; do
    PLANS+=("$PLAN")
done < <(git diff --cached --name-only --diff-filter=A -M -z -- ':(glob)plans/**/PLAN.md')
if [ ${#PLANS[@]} -gt 0 ]; then
    if ! command -v cmake &> /dev/null; then
        echo "pre-commit: cmake is needed to check the Placement section of each new PLAN.md; commit aborted."
        exit 1
    fi
    STAGED=$(mktemp -d)
    trap 'rm -rf "$STAGED"' EXIT
    git checkout-index --prefix="$STAGED/" -- "${PLANS[@]}"
    PLAN_LIST=$(IFS=';'; echo "${PLANS[*]}")
    if ! cmake -DROOT="$STAGED" -DPLANS="$PLAN_LIST" \
            -P "$(git rev-parse --show-toplevel)/cmake/check_placement.cmake"; then
        echo "pre-commit: each new PLAN.md needs a Placement section (decision 0027); commit aborted."
        exit 1
    fi
fi

# A new test case tests one property, not one section per input.
if ! "$(git rev-parse --show-toplevel)/scripts/check-test-sections.sh"; then
    echo "pre-commit: commit aborted."
    exit 1
fi

if command -v clang-format &> /dev/null; then
    CLANG_FORMAT="clang-format"
elif command -v clang-format.exe &> /dev/null; then
    CLANG_FORMAT="clang-format.exe"
else
    echo "pre-commit: clang-format not found; skipping format pass."
    exit 0
fi

git diff --cached --name-only --diff-filter=ACM -z -- '*.cpp' '*.h' |
while IFS= read -r -d '' FILE; do
    if git diff --quiet -- "$FILE"; then
        $CLANG_FORMAT -i "$FILE"
        if ! git diff --quiet -- "$FILE"; then
            git add -- "$FILE"
            echo "Formatted: $FILE"
        fi
    else
        STAGED_BLOB=$(git rev-parse ":$FILE")
        FORMATTED_BLOB=$(git cat-file blob "$STAGED_BLOB" |
            $CLANG_FORMAT --assume-filename="$FILE" | git hash-object -w --stdin)
        if [ "$FORMATTED_BLOB" != "$STAGED_BLOB" ]; then
            MODE=$(git ls-files -s -- "$FILE" | cut -d' ' -f1)
            git update-index --cacheinfo "$MODE,$FORMATTED_BLOB,$FILE"
            echo "Formatted staged version only (unstaged changes kept as they were): $FILE"
        fi
    fi
done
exit 0
